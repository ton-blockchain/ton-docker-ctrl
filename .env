TON_BRANCH=latest
NETWORK=mainnet
# consider switching global config to testnet https://ton.org/testnet-global.config.json, if you change NETWORK to testnet
# LOBAL_CONFIG_URL=https://ton.org/testnet-global.config.json
GLOBAL_CONFIG_URL=https://ton.org/global.config.json
MYTONCTRL_VERSION=master
TELEMETRY=true
IGNORE_MINIMAL_REQS=false
MODE=validator
DUMP=true
ARCHIVE_TTL=86400
STATE_TTL=86400
VERBOSITY=1
CUSTOM_PARAMETERS=
PUBLIC_IP=
VALIDATOR_PORT=30001
QUIC_PORT=31001
LITESERVER_PORT=30003
VALIDATOR_CONSOLE_PORT=30002
